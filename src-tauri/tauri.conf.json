{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyCut",
  "version": "0.1.0",
  "identifier": "app.mycut.desktop",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "MyCut",
        "width": 1400,
        "height": 860,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": []
  }
}
